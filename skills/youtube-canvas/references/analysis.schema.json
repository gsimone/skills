{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YouTube Canvas Analysis",
  "type": "object",
  "required": ["mode", "summary", "keyIdeas", "segments"],
  "properties": {
    "mode": { "enum": ["research", "watch"] },
    "summary": { "type": "string", "minLength": 1 },
    "keyIdeas": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "maxItems": 20
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "start", "end", "title", "summary", "cluster"],
        "properties": {
          "id": { "type": "string", "pattern": "^seg-[0-9]{3,}$" },
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number", "minimum": 0 },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "whyItMatters": { "type": "string" },
          "quote": { "type": "string" },
          "cluster": { "type": "string", "minLength": 1 },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "maxItems": 8
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
